{
  "openapi": "3.1.0",
  "info": {
    "title": "Получить статус задачи Kling 'изображение в видео'",
    "version": "1.0.0",
    "description": "Запросить статус и результаты задачи Kling по созданию видео из изображения."
  },
  "tags": [
    {
      "name": "Видео (Videos)/формат Kling"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Аутентификация с помощью Bearer Token.\nФормат: `Authorization: Bearer sk-xxxxxx`\n"
      }
    }
  },
  "paths": {
    "/kling/v1/videos/image2video/{task_id}": {
      "get": {
        "tags": [
          "Видео (Videos)/формат Kling"
        ],
        "summary": "Получить статус задачи Kling 'изображение в видео'",
        "description": "Запросить статус и результаты задачи Kling по созданию видео из изображения.",
        "operationId": "getklingimage2video",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "description": "ID задачи",
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Статус задачи успешно получен",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Ответ на запрос состояния задачи видео",
                  "properties": {
                    "task_id": {
                      "type": "string",
                      "description": "ID задачи",
                      "examples": [
                        "abcd1234efgh"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "description": "Статус задачи",
                      "enum": [
                        "queued",
                        "in_progress",
                        "completed",
                        "failed"
                      ],
                      "examples": [
                        "completed"
                      ]
                    },
                    "url": {
                      "type": "string",
                      "description": "URL ресурса видео (при успехе)",
                      "examples": [
                        "https://example.com/video.mp4"
                      ]
                    },
                    "format": {
                      "type": "string",
                      "description": "Формат видео",
                      "examples": [
                        "mp4"
                      ]
                    },
                    "metadata": {
                      "type": "object",
                      "description": "Метаданные задачи видео",
                      "properties": {
                        "duration": {
                          "type": "number",
                          "description": "Фактическая длительность сгенерированного видео",
                          "examples": [
                            5
                          ]
                        },
                        "fps": {
                          "type": "integer",
                          "description": "Фактическая частота кадров",
                          "examples": [
                            30
                          ]
                        },
                        "width": {
                          "type": "integer",
                          "description": "Фактическая ширина",
                          "examples": [
                            1280
                          ]
                        },
                        "height": {
                          "type": "integer",
                          "description": "Фактическая высота",
                          "examples": [
                            720
                          ]
                        },
                        "seed": {
                          "type": "integer",
                          "description": "Используемое случайное зерно",
                          "examples": [
                            20231234
                          ]
                        }
                      },
                      "x-apifox-orders": [
                        "duration",
                        "fps",
                        "width",
                        "height",
                        "seed"
                      ]
                    },
                    "error": {
                      "type": "object",
                      "description": "Сообщение об ошибке задачи видео",
                      "properties": {
                        "code": {
                          "type": "integer",
                          "description": "Код ошибки"
                        },
                        "message": {
                          "type": "string",
                          "description": "Сообщение об ошибке"
                        }
                      },
                      "x-apifox-orders": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "x-apifox-orders": [
                    "task_id",
                    "status",
                    "url",
                    "format",
                    "metadata",
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Задача не существует",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "description": "Сообщение об ошибке"
                        },
                        "type": {
                          "type": "string",
                          "description": "Тип ошибки"
                        },
                        "param": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Соответствующие параметры"
                        },
                        "code": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Код ошибки"
                        }
                      },
                      "x-apifox-orders": [
                        "message",
                        "type",
                        "param",
                        "code"
                      ]
                    }
                  },
                  "x-apifox-orders": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
