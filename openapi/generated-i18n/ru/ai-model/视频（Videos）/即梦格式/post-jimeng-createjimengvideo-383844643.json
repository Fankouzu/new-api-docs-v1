{
  "openapi": "3.1.0",
  "info": {
    "title": "Генерация видео Jimeng",
    "version": "1.0.0",
    "description": "Интерфейс генерации видео в формате официального API Jimeng.\n\nПоддерживает указание типа операции через параметр Action:\n- `CVSync2AsyncSubmitTask`: отправка задачи генерации видео\n- `CVSync2AsyncGetResult`: получение результата задачи\n\nНеобходимо указать Action и Version в параметрах запроса.\n"
  },
  "tags": [
    {
      "name": "Видео (Videos)/формат Jimeng"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Аутентификация с помощью Bearer Token.\nФормат: `Authorization: Bearer sk-xxxxxx`\n"
      }
    }
  },
  "paths": {
    "/jimeng/": {
      "post": {
        "tags": [
          "Видео (Videos)/формат Jimeng"
        ],
        "summary": "Генерация видео Jimeng",
        "description": "Интерфейс генерации видео в формате официального API Jimeng.\n\nПоддерживает указание типа операции через параметр Action:\n- `CVSync2AsyncSubmitTask`: отправка задачи генерации видео\n- `CVSync2AsyncGetResult`: получение результата задачи\n\nНеобходимо указать Action и Version в параметрах запроса.\n",
        "operationId": "createjimengvideo",
        "parameters": [
          {
            "name": "Action",
            "in": "query",
            "required": true,
            "description": "Тип операции API",
            "schema": {
              "type": "string",
              "enum": [
                "CVSync2AsyncSubmitTask",
                "CVSync2AsyncGetResult"
              ]
            }
          },
          {
            "name": "Version",
            "in": "query",
            "required": true,
            "description": "Версия API",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Формат запроса официального API Jimeng",
                "properties": {
                  "req_key": {
                    "type": "string",
                    "description": "Идентификатор типа запроса"
                  },
                  "prompt": {
                    "type": "string",
                    "description": "Текстовое описание"
                  },
                  "binary_data_base64": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Данные изображения в кодировке Base64"
                  }
                },
                "x-apifox-orders": [
                  "req_key",
                  "prompt",
                  "binary_data_base64"
                ]
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Запрос успешно обработан",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "description": "Код ответа"
                    },
                    "message": {
                      "type": "string",
                      "description": "Сообщение ответа"
                    },
                    "data": {
                      "type": "object",
                      "description": "Данные ответа",
                      "x-apifox-orders": []
                    }
                  },
                  "x-apifox-orders": [
                    "code",
                    "message",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Ошибка параметров запроса",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "description": "Сообщение об ошибке"
                        },
                        "type": {
                          "type": "string",
                          "description": "Тип ошибки"
                        },
                        "param": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Соответствующие параметры"
                        },
                        "code": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "Код ошибки"
                        }
                      },
                      "x-apifox-orders": [
                        "message",
                        "type",
                        "param",
                        "code"
                      ]
                    }
                  },
                  "x-apifox-orders": [
                    "error"
                  ]
                }
              }
