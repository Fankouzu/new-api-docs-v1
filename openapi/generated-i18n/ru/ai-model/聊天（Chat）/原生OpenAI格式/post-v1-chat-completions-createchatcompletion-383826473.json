{
  "openapi": "3.1.0",
  "info": {
    "title": "Формат ChatCompletions",
    "version": "1.0.0",
    "description": "Создать ответ модели на основе истории диалога. Поддерживает потоковый и непотоковый режимы.\n\nСовместимо с OpenAI Chat Completions API.\n"
  },
  "tags": [
    {
      "name": "Чат (Chat)/родной формат OpenAI"
    }
  ],
  "components": {
